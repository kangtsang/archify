    { "id": "merge", "lane": "git", "col": 5, "width": 130, "type": "backend", "label": "合并回目标分支", "sublabel": "③ git merge --no-ff" },
    { "id": "resolve", "lane": "conflict", "col": 5, "width": 130, "type": "frontend", "label": "解决并提交", "sublabel": "再点「继续结束任务」" },
    { "id": "cleanup", "lane": "user", "col": 5, "width": 130, "type": "database", "label": "归档并注销工作区", "sublabel": "全部完成才删任务空间" }
  ],
  "edges": [
    { "from": "install", "to": "dialog", "role": "main" },
    { "from": "dialog", "to": "create", "label": "创建并打开", "role": "main" },
    { "from": "create", "to": "session", "role": "main" },
    { "from": "session", "to": "finish", "label": "任务修改完成后", "role": "main" },
    { "from": "finish", "to": "trial", "role": "main" },
    { "from": "trial", "to": "merge", "role": "main" },
    { "from": "merge", "to": "cleanup", "role": "main" },
    { "from": "trial", "to": "conflict", "label": "冲突", "variant": "security", "role": "error" },
    { "from": "conflict", "to": "resolve" },
    { "from": "resolve", "to": "merge", "label": "继续结束任务", "role": "return" }
