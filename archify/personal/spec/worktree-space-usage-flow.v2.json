  "cards": [
    {
      "dot": "cyan",
      "title": "入口与隔离",
      "items": [
        "两个入口：侧边栏底部 / 新会话下方",
        "三视图可搜索、可筛「待处理」",
        "每仓库一份 worktree，源码检出不动"
      ]
    },
    {
      "dot": "amber",
      "title": "为什么先反向试合并",
      "items": [
        "真合并冲突会落在源检出上",
        "先在任务 worktree 里试一次",
        "干净则撤销再合并；占用时走临时 worktree"
      ]
    },
    {
      "dot": "rose",
      "title": "插件不替你做决定",
      "items": [
        "不代写提交：改动挡住确认",
        "不自动 abort：冲突现场原样保留",
        "交由 agent 是实验性入口，可隐藏"
      ]
    }
  ]
}
