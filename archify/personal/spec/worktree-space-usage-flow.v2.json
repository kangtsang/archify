  ],
  "mainPath": ["install", "dialog", "create", "session", "finish", "trial", "merge", "cleanup"],
  "nodes": [
    { "id": "install", "lane": "user", "col": 0, "width": 112, "type": "frontend", "label": "安装并配置插件", "sublabel": "入口 · 前缀 · 归档" },
    { "id": "dialog", "lane": "user", "col": 1, "width": 136, "type": "frontend", "label": "新建任务空间", "sublabel": "任务名 · 前缀 · 容器根" },
    { "id": "create", "lane": "git", "col": 1, "width": 136, "type": "backend", "label": "建 worktree", "sublabel": "每仓库一份任务分支" },
    { "id": "session", "lane": "session", "col": 3, "width": 136, "type": "frontend", "label": "注册并打开会话", "sublabel": "Agent 跨仓库改代码" },
    { "id": "finish", "lane": "user", "col": 4, "width": 124, "type": "frontend", "label": "结束任务", "sublabel": "① 先自行提交改动" },
    { "id": "trial", "lane": "git", "col": 4, "width": 124, "type": "backend", "label": "反向试合并", "sublabel": "② 目标 → 任务分支" },
